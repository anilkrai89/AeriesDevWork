    <start>
        <locationX>530</locationX>
        <locationY>48</locationY>
        <connector>
            <targetReference>Check_for_any_ARR_FF_ARR_in_Hierarchy</targetReference>
        </connector>
        <filterFormula>AND(

OR(
ISCHANGED({!$Record.Temp_ARR__c}),
ISCHANGED({!$Record.FastField_ARR__c})),

OR(

({!$Record__Prior.Temp_ARR__c} &lt;= 0 || ISBLANK({!$Record__Prior.Temp_ARR__c})) &amp;&amp; {!$Record.Temp_ARR__c} &gt; 0,

({!$Record__Prior.FastField_ARR__c} &lt;= 0 || ISBLANK({!$Record__Prior.FastField_ARR__c})) &amp;&amp; {!$Record.FastField_ARR__c} &gt; 0,

({!$Record.FastField_ARR__c} &lt;= 0 || ISBLANK({!$Record.FastField_ARR__c}) &amp;&amp; {!$Record__Prior.FastField_ARR__c} &gt; 0),

({!$Record.Temp_ARR__c} &lt;= 0 || ISBLANK({!$Record__Prior.Temp_ARR__c}) &amp;&amp; {!$Record__Prior.Temp_ARR__c} &gt; 0)))</filterFormula>
        <object>Account</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
