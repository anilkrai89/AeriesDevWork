    <description>added variable &apos;ShouldBlockCaseProgression&apos; to prompt error message for missing problem field..</description>
    <environments>Default</environments>
    <formulas>
        <name>Now</name>
        <dataType>DateTime</dataType>
        <expression>NOW()</expression>
    </formulas>
    <formulas>
        <name>ShouldBlockCaseProgression</name>
        <dataType>Boolean</dataType>
        <expression>AND(
  ISCHANGED($Record.Parent.Status),
  ISPICKVAL($Record.Parent.Type, &quot;Standard&quot;),
  ISPICKVAL(PRIORVALUE($Record.Parent.Status), &quot;New&quot;),
  OR(
    ISBLANK(TEXT($Record.Parent.Functional_Area__c)),
    ISBLANK(TEXT($Record.Parent.Request_Type__c)),
    AND(
      NOT(ISBLANK(TEXT($Record.Parent.Functional_Area__c))),
      OR(
        ISPICKVAL($Record.Parent.Functional_Area__c, &quot;User Management&quot;),
        ISPICKVAL($Record.Parent.Functional_Area__c, &quot;Pipelines&quot;),
        ISPICKVAL($Record.Parent.Functional_Area__c, &quot;App Copy, Transfer or Restore&quot;),
        ISPICKVAL($Record.Parent.Functional_Area__c, &quot;Realm Questions or Changes&quot;),
        ISPICKVAL($Record.Parent.Functional_Area__c, &quot;Account Questions or Changes&quot;),
        ISPICKVAL($Record.Parent.Functional_Area__c, &quot;Password Reset&quot;),
        ISPICKVAL($Record.Parent.Functional_Area__c, &quot;Forms&quot;),
        ISPICKVAL($Record.Parent.Functional_Area__c, &quot;Reporting&quot;),
        ISPICKVAL($Record.Parent.Functional_Area__c, &quot;Notifications/Subscriptions/Reminders&quot;),
        ISPICKVAL($Record.Parent.Functional_Area__c, &quot;Performance&quot;),
        ISPICKVAL($Record.Parent.Functional_Area__c, &quot;Fields&quot;),
        ISPICKVAL($Record.Parent.Functional_Area__c, &quot;Connected Tables or Syncs&quot;),
        ISPICKVAL($Record.Parent.Functional_Area__c, &quot;SSO/SAML&quot;),
        ISPICKVAL($Record.Parent.Functional_Area__c, &quot;Formula Fields&quot;),
        ISPICKVAL($Record.Parent.Functional_Area__c, &quot;Roles and Permissions&quot;),
        ISPICKVAL($Record.Parent.Functional_Area__c, &quot;Billing Questions or Changes&quot;)
      ),
      ISBLANK(TEXT($Record.Parent.Problem__c))
    )
  )
)</expression>
    </formulas>
