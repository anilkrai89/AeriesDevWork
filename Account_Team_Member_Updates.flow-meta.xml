    <decisions>
        <description>Criteria to check if CAE Needed on Account has correct assignment. If a CAE Exists on Account Team, CAE Needed should be False. If no CAE Exists, CAE Needed should be True.</description>
        <name>Account_CAE_Needed</name>
        <label>Account CAE Needed</label>
        <locationX>412</locationX>
        <locationY>1127</locationY>
        <defaultConnector>
            <targetReference>CAE_Needed_to_False</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Account CAE not Needed</defaultConnectorLabel>
        <rules>
            <name>outcome_Account_CAE_Needed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>boolNoOtherCAE</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.TeamMemberRole</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Customer Account Executive</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_CAE_Needed_to_True</targetReference>
            </connector>
            <label>Account CAE Needed</label>
        </rules>
    </decisions>
