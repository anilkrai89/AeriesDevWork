        <rules>
            <name>Last_in_Loop</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varLoopCounter</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>varSubCount</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Copy_2_of_Adding_Customer_Total</targetReference>
            </connector>
            <label>Last in Loop</label>
        </rules>
        <rules>
            <name>Same_Segment_Key</name>
            <conditionLogic>(1 AND 2 AND 3) OR 4</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Subscriptions.SBQQ__SegmentKey__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>varCurrentSegmentKey</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_Subscriptions.SBQQ__Product__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>varCurrentProduct</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_Subscriptions.Quote__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>varCurrentQuote</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varLoopCounter</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Adding_Customer_Total</targetReference>
            </connector>
            <label>Same Segment Key or First in Loop</label>
        </rules>
    </decisions>
