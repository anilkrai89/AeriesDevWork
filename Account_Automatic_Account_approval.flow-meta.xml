    <recordLookups>
        <name>Look_for_duplicate_Account</name>
        <label>Look for duplicate Account</label>
        <locationX>587</locationX>
        <locationY>545</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Is_there_a_duplicate_Account</targetReference>
        </connector>
        <filterLogic>1 AND 4 AND 5 AND (2 OR 3)</filterLogic>
        <filters>
            <field>Id</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>DOZISF__ZoomInfo_Id__c</field>
