    <decisions>
        <name>Is_the_Shipping_Address_a_PO_box</name>
        <label>Is the Shipping Address a PO box?</label>
        <locationX>785</locationX>
        <locationY>761</locationY>
        <defaultConnector>
            <targetReference>Update_Account_to_Approved</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Shipping address does not contain a PO Box</defaultConnectorLabel>
        <rules>
            <name>Yes_Shipping_Address_contains_a_PO_Box</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>lowerCaseShippingStreet</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>po box</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>lowerCaseShippingStreet</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>p.o. box</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Was_PO_Box_Task_already_sent_to_GTM</targetReference>
            </connector>
            <label>Yes - Shipping Address contains a PO Box</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_there_a_duplicate_Account</name>
        <label>Is there a duplicate Account?</label>
        <locationX>537</locationX>
        <locationY>782</locationY>
        <defaultConnector>
            <targetReference>Is_the_Shipping_Address_a_PO_box</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No duplicate found</defaultConnectorLabel>
        <rules>
            <name>Yes_duplicate_Account_found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Look_for_duplicate_Account</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_GTM_Ops_Duplicate_Account_Task</targetReference>
            </connector>
            <label>Yes - duplicate Account found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Was_Duplicate_Task_already_sent_to_GTM</name>
        <label>Was Duplicate Task already sent to GTM?</label>
        <locationX>841</locationX>
        <locationY>419</locationY>
        <defaultConnector>
            <targetReference>Look_for_duplicate_Account</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Dupe_Task_already_sent</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.GTM_Task_Sent_Duplicate_Account__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Is_the_Shipping_Address_a_PO_box</targetReference>
            </connector>
            <label>Yes - Dupe Task already sent</label>
        </rules>
    </decisions>
    <decisions>
        <name>Was_PO_Box_Task_already_sent_to_GTM</name>
        <label>Was PO Box Task already sent to GTM?</label>
        <locationX>868</locationX>
        <locationY>1031</locationY>
        <defaultConnector>
            <targetReference>Create_GTM_Ops_Task</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_PO_Box_Task_already_sent</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.GTM_Task_Sent_PO_Box__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>Yes - PO Box Task already sent</label>
        </rules>
    </decisions>
