<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Set_the_Case_ID</name>
        <label>Set the Case ID</label>
        <locationX>695</locationX>
        <locationY>432</locationY>
        <assignmentItems>
            <assignToReference>rvCaseID.Id</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.WorkItemId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>rvCaseID.Omni_Assigned__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_something_on_the_case</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Bypass_Flow</name>
        <label>Bypass Flow?</label>
        <locationX>339</locationX>
        <locationY>326</locationY>
        <defaultConnector>
            <targetReference>Set_the_Case_ID</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Run Flow</defaultConnectorLabel>
        <rules>
            <name>Yes_Bypass</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Permission.Exclude_from_Flows</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>Yes Bypass</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>AgentWork: email case owner on Omnichannel assigment {!$Flow.CurrentDateTime}</interviewLabel>
    <label>AgentWork: email case owner on Omnichannel assigment</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_something_on_the_case</name>
        <label>Update something on the case</label>
        <locationX>695</locationX>
        <locationY>540</locationY>
        <inputReference>rvCaseID</inputReference>
    </recordUpdates>
    <start>
        <locationX>635</locationX>
        <locationY>48</locationY>
        <connector>
            <targetReference>Bypass_Flow</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>WorkItemId</field>
            <operator>StartsWith</operator>
            <value>
                <stringValue>500</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Assigned</stringValue>
            </value>
        </filters>
        <object>AgentWork</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <textTemplates>
        <name>txtEmailNewCase</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>You just got this case assigned to you {!rvCaseID.CaseNumber}</text>
    </textTemplates>
    <textTemplates>
        <name>txtEmailSubject</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;&lt;span style=&quot;font-size: 13px;&quot;&gt;You got a new {!rvCaseID.Priority} case  {!rvCaseID.CaseNumber}&lt;/span&gt;&lt;/p&gt;</text>
    </textTemplates>
    <variables>
        <name>rvCaseID</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Case</objectType>
    </variables>
    <variables>
        <name>vCaseID</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
