            <conditions>
                <leftValueReference>$Record.QS_New_Asset_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Pending Activation</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.QS_Account__r.Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Prospect</stringValue>
                </rightValue>
            </conditions>
            <label>Update Prospect</label>
        </rules>
        <rules>
            <name>Update_Partner</name>
            <conditionLogic>1 AND 3 AND (2 OR 4)</conditionLogic>
