    <description>Updated ProApp Tasks to always send to Solution Consultants queue</description>
    <environments>Default</environments>
    <formulas>
        <name>AEOwnerFormula</name>
        <dataType>String</dataType>
        <expression>IF({!Pro_App_Task_is_assigned_to_a_Lead}, {!Get_related_Lead.OwnerId}, 

IF({!Pro_App_Task_is_assigned_to_a_Contact}, {!Get_related_Contact.OwnerId},

{!$Record.OwnerId}))</expression>
    </formulas>
    <formulas>
        <name>SDROwnerFormula</name>
        <dataType>String</dataType>
        <expression>IF(BEGINS({!$Record.WhoId}, &apos;00Q&apos;) &amp;&amp; NOT(ISBLANK({!Get_related_Lead.SDR_Owner__r.Id})),

{!Get_related_Lead.SDR_Owner__r.Id},

IF(BEGINS({!$Record.WhoId}, &apos;003&apos;) &amp;&amp; NOT(ISBLANK({!Get_related_Contact.SDR_Owner__r.Id})), 

{!Get_related_Contact.SDR_Owner__r.Id},

IF(BEGINS({!$Record.WhoId}, &apos;00Q&apos;), {!Get_related_Lead.OwnerId}, {!Get_related_Contact.OwnerId})))</expression>
    </formulas>
